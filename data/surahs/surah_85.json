{
  "surah": 85,
  "name": "Al-Buruj",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ"
    },
    {
      "ayah_number": 2,
      "text": "وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ"
    },
    {
      "ayah_number": 3,
      "text": "وَشَاهِدٖ وَمَشۡهُودٖ"
    },
    {
      "ayah_number": 4,
      "text": "قُتِلَ أَصۡحَابُ ٱلۡأُخۡدُودِ"
    },
    {
      "ayah_number": 5,
      "text": "ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ"
    },
    {
      "ayah_number": 6,
      "text": "إِذۡ هُمۡ عَلَيۡهَا قُعُودٞ"
    },
    {
      "ayah_number": 7,
      "text": "وَهُمۡ عَلَىا مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودٞ"
    },
    {
      "ayah_number": 8,
      "text": "وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ"
    },
    {
      "ayah_number": 9,
      "text": "ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَاوَاتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىا كُلِّ شَيۡءٖ شَهِيدٌ"
    },
    {
      "ayah_number": 10,
      "text": "إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَاتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ"
    },
    {
      "ayah_number": 11,
      "text": "إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـالِحَاتِ لَهُمۡ جَنَّـاتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَارُۚ ذَالِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ"
    },
    {
      "ayah_number": 12,
      "text": "إِنَّ بَطۡشَ رَبِّكَ لَشَدِيدٌ"
    },
    {
      "ayah_number": 13,
      "text": "إِنَّهُۥ هُوَ يُبۡدِئُ وَيُعِيدُ"
    },
    {
      "ayah_number": 14,
      "text": "وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ"
    },
    {
      "ayah_number": 15,
      "text": "ذُو ٱلۡعَرۡشِ ٱلۡمَجِيدُ"
    },
    {
      "ayah_number": 16,
      "text": "فَعَّالٞ لِّمَا يُرِيدُ"
    },
    {
      "ayah_number": 17,
      "text": "هَلۡ أَتَىاكَ حَدِيثُ ٱلۡجُنُودِ"
    },
    {
      "ayah_number": 18,
      "text": "فِرۡعَوۡنَ وَثَمُودَ"
    },
    {
      "ayah_number": 19,
      "text": "بَلِ ٱلَّذِينَ كَفَرُواْ فِي تَكۡذِيبٖ"
    },
    {
      "ayah_number": 20,
      "text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطُۢ"
    },
    {
      "ayah_number": 21,
      "text": "بَلۡ هُوَ قُرۡءَانٞ مَّجِيدٞ"
    },
    {
      "ayah_number": 22,
      "text": "فِي لَوۡحٖ مَّحۡفُوظِۭ"
    }
  ]
}
