{
  "surah": 84,
  "name": "Al-Inshiqaq",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ"
    },
    {
      "ayah_number": 2,
      "text": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"
    },
    {
      "ayah_number": 3,
      "text": "وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ"
    },
    {
      "ayah_number": 4,
      "text": "وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ"
    },
    {
      "ayah_number": 5,
      "text": "وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ"
    },
    {
      "ayah_number": 6,
      "text": "يَـآأَيُّهَا ٱلۡإِنسَانُ إِنَّكَ كَادِحٌ إِلَىا رَبِّكَ كَدۡحٗا فَمُلَاقِيهِ"
    },
    {
      "ayah_number": 7,
      "text": "فَأَمَّا مَنۡ أُوتِيَ كِتَابَهُۥ بِيَمِينِهِۦ"
    },
    {
      "ayah_number": 8,
      "text": "فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا"
    },
    {
      "ayah_number": 9,
      "text": "وَيَنقَلِبُ إِلَىآ أَهۡلِهِۦ مَسۡرُورٗا"
    },
    {
      "ayah_number": 10,
      "text": "وَأَمَّا مَنۡ أُوتِيَ كِتَابَهُۥ وَرَآءَ ظَهۡرِهِۦ"
    },
    {
      "ayah_number": 11,
      "text": "فَسَوۡفَ يَدۡعُواْ ثُبُورٗا"
    },
    {
      "ayah_number": 12,
      "text": "وَيَصۡلَىا سَعِيرًا"
    },
    {
      "ayah_number": 13,
      "text": "إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا"
    },
    {
      "ayah_number": 14,
      "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ"
    },
    {
      "ayah_number": 15,
      "text": "بَلَىآۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا"
    },
    {
      "ayah_number": 16,
      "text": "فَلَآ أُقۡسِمُ بِٱلشَّفَقِ"
    },
    {
      "ayah_number": 17,
      "text": "وَٱلَّيۡلِ وَمَا وَسَقَ"
    },
    {
      "ayah_number": 18,
      "text": "وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ"
    },
    {
      "ayah_number": 19,
      "text": "لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ"
    },
    {
      "ayah_number": 20,
      "text": "فَمَا لَهُمۡ لَا يُؤۡمِنُونَ"
    },
    {
      "ayah_number": 21,
      "text": "وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩"
    },
    {
      "ayah_number": 22,
      "text": "بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ"
    },
    {
      "ayah_number": 23,
      "text": "وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ"
    },
    {
      "ayah_number": 24,
      "text": "فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ"
    },
    {
      "ayah_number": 25,
      "text": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـالِحَاتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ"
    }
  ]
}
