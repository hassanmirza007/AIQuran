{
  "surah": 97,
  "name": "Al-Qadr",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "إِنَّآ أَنزَلۡنَاهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ"
    },
    {
      "ayah_number": 2,
      "text": "وَمَآ أَدۡرَىاكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ"
    },
    {
      "ayah_number": 3,
      "text": "لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ"
    },
    {
      "ayah_number": 4,
      "text": "تَنَزَّلُ ٱلۡمَلَـآئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ"
    },
    {
      "ayah_number": 5,
      "text": "سَلَامٌ هِيَ حَتَّىا مَطۡلَعِ ٱلۡفَجۡرِ"
    }
  ]
}
