{
  "surah": 82,
  "name": "Al-Infitar",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ"
    },
    {
      "ayah_number": 2,
      "text": "وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ"
    },
    {
      "ayah_number": 3,
      "text": "وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ"
    },
    {
      "ayah_number": 4,
      "text": "وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ"
    },
    {
      "ayah_number": 5,
      "text": "عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ"
    },
    {
      "ayah_number": 6,
      "text": "يَـآأَيُّهَا ٱلۡإِنسَانُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ"
    },
    {
      "ayah_number": 7,
      "text": "ٱلَّذِي خَلَقَكَ فَسَوَّىاكَ فَعَدَلَكَ"
    },
    {
      "ayah_number": 8,
      "text": "فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ"
    },
    {
      "ayah_number": 9,
      "text": "كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ"
    },
    {
      "ayah_number": 10,
      "text": "وَإِنَّ عَلَيۡكُمۡ لَحَافِظِينَ"
    },
    {
      "ayah_number": 11,
      "text": "كِرَامٗا كَاتِبِينَ"
    },
    {
      "ayah_number": 12,
      "text": "يَعۡلَمُونَ مَا تَفۡعَلُونَ"
    },
    {
      "ayah_number": 13,
      "text": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ"
    },
    {
      "ayah_number": 14,
      "text": "وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ"
    },
    {
      "ayah_number": 15,
      "text": "يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ"
    },
    {
      "ayah_number": 16,
      "text": "وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ"
    },
    {
      "ayah_number": 17,
      "text": "وَمَآ أَدۡرَىاكَ مَا يَوۡمُ ٱلدِّينِ"
    },
    {
      "ayah_number": 18,
      "text": "ثُمَّ مَآ أَدۡرَىاكَ مَا يَوۡمُ ٱلدِّينِ"
    },
    {
      "ayah_number": 19,
      "text": "يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ"
    }
  ]
}
