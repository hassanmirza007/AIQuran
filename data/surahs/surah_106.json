{
  "surah": 106,
  "name": "Quraysh",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "لِإِيلَافِ قُرَيۡشٍ"
    },
    {
      "ayah_number": 2,
      "text": "إِۦلَافِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ"
    },
    {
      "ayah_number": 3,
      "text": "فَلۡيَعۡبُدُواْ رَبَّ هَاذَا ٱلۡبَيۡتِ"
    },
    {
      "ayah_number": 4,
      "text": "ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ"
    }
  ]
}
