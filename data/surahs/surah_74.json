{
  "surah": 74,
  "name": "Al-Muddaththir",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "يَـآأَيُّهَا ٱلۡمُدَّثِّرُ"
    },
    {
      "ayah_number": 2,
      "text": "قُمۡ فَأَنذِرۡ"
    },
    {
      "ayah_number": 3,
      "text": "وَرَبَّكَ فَكَبِّرۡ"
    },
    {
      "ayah_number": 4,
      "text": "وَثِيَابَكَ فَطَهِّرۡ"
    },
    {
      "ayah_number": 5,
      "text": "وَٱلرُّجۡزَ فَٱهۡجُرۡ"
    },
    {
      "ayah_number": 6,
      "text": "وَلَا تَمۡنُن تَسۡتَكۡثِرُ"
    },
    {
      "ayah_number": 7,
      "text": "وَلِرَبِّكَ فَٱصۡبِرۡ"
    },
    {
      "ayah_number": 8,
      "text": "فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ"
    },
    {
      "ayah_number": 9,
      "text": "فَذَالِكَ يَوۡمَئِذٖ يَوۡمٌ عَسِيرٌ"
    },
    {
      "ayah_number": 10,
      "text": "عَلَى ٱلۡكَافِرِينَ غَيۡرُ يَسِيرٖ"
    },
    {
      "ayah_number": 11,
      "text": "ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا"
    },
    {
      "ayah_number": 12,
      "text": "وَجَعَلۡتُ لَهُۥ مَالٗا مَّمۡدُودٗا"
    },
    {
      "ayah_number": 13,
      "text": "وَبَنِينَ شُهُودٗا"
    },
    {
      "ayah_number": 14,
      "text": "وَمَهَّدتُّ لَهُۥ تَمۡهِيدٗا"
    },
    {
      "ayah_number": 15,
      "text": "ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ"
    },
    {
      "ayah_number": 16,
      "text": "كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَاتِنَا عَنِيدٗا"
    },
    {
      "ayah_number": 17,
      "text": "سَأُرۡهِقُهُۥ صَعُودًا"
    },
    {
      "ayah_number": 18,
      "text": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ"
    },
    {
      "ayah_number": 19,
      "text": "فَقُتِلَ كَيۡفَ قَدَّرَ"
    },
    {
      "ayah_number": 20,
      "text": "ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ"
    },
    {
      "ayah_number": 21,
      "text": "ثُمَّ نَظَرَ"
    },
    {
      "ayah_number": 22,
      "text": "ثُمَّ عَبَسَ وَبَسَرَ"
    },
    {
      "ayah_number": 23,
      "text": "ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ"
    },
    {
      "ayah_number": 24,
      "text": "فَقَالَ إِنۡ هَاذَآ إِلَّا سِحۡرٞ يُؤۡثَرُ"
    },
    {
      "ayah_number": 25,
      "text": "إِنۡ هَاذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ"
    },
    {
      "ayah_number": 26,
      "text": "سَأُصۡلِيهِ سَقَرَ"
    },
    {
      "ayah_number": 27,
      "text": "وَمَآ أَدۡرَىاكَ مَا سَقَرُ"
    },
    {
      "ayah_number": 28,
      "text": "لَا تُبۡقِي وَلَا تَذَرُ"
    },
    {
      "ayah_number": 29,
      "text": "لَوَّاحَةٞ لِّلۡبَشَرِ"
    },
    {
      "ayah_number": 30,
      "text": "عَلَيۡهَا تِسۡعَةَ عَشَرَ"
    },
    {
      "ayah_number": 31,
      "text": "وَمَا جَعَلۡنَآ أَصۡحَابَ ٱلنَّارِ إِلَّا مَلَـآئِكَةٗۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةٗ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَابَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَانٗا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَابَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ وَٱلۡكَافِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَاذَا مَثَلٗاۚ كَذَالِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىا لِلۡبَشَرِ"
    },
    {
      "ayah_number": 32,
      "text": "كَلَّا وَٱلۡقَمَرِ"
    },
    {
      "ayah_number": 33,
      "text": "وَٱلَّيۡلِ إِذۡ أَدۡبَرَ"
    },
    {
      "ayah_number": 34,
      "text": "وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ"
    },
    {
      "ayah_number": 35,
      "text": "إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ"
    },
    {
      "ayah_number": 36,
      "text": "نَذِيرٗا لِّلۡبَشَرِ"
    },
    {
      "ayah_number": 37,
      "text": "لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ"
    },
    {
      "ayah_number": 38,
      "text": "كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ"
    },
    {
      "ayah_number": 39,
      "text": "إِلَّآ أَصۡحَابَ ٱلۡيَمِينِ"
    },
    {
      "ayah_number": 40,
      "text": "فِي جَنَّـاتٖ يَتَسَآءَلُونَ"
    },
    {
      "ayah_number": 41,
      "text": "عَنِ ٱلۡمُجۡرِمِينَ"
    },
    {
      "ayah_number": 42,
      "text": "مَا سَلَكَكُمۡ فِي سَقَرَ"
    },
    {
      "ayah_number": 43,
      "text": "قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ"
    },
    {
      "ayah_number": 44,
      "text": "وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ"
    },
    {
      "ayah_number": 45,
      "text": "وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ"
    },
    {
      "ayah_number": 46,
      "text": "وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ"
    },
    {
      "ayah_number": 47,
      "text": "حَتَّىآ أَتَىانَا ٱلۡيَقِينُ"
    },
    {
      "ayah_number": 48,
      "text": "فَمَا تَنفَعُهُمۡ شَفَاعَةُ ٱلشَّـافِعِينَ"
    },
    {
      "ayah_number": 49,
      "text": "فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ"
    },
    {
      "ayah_number": 50,
      "text": "كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ"
    },
    {
      "ayah_number": 51,
      "text": "فَرَّتۡ مِن قَسۡوَرَةِۭ"
    },
    {
      "ayah_number": 52,
      "text": "بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىا صُحُفٗا مُّنَشَّرَةٗ"
    },
    {
      "ayah_number": 53,
      "text": "كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ"
    },
    {
      "ayah_number": 54,
      "text": "كَلَّآ إِنَّهُۥ تَذۡكِرَةٞ"
    },
    {
      "ayah_number": 55,
      "text": "فَمَن شَآءَ ذَكَرَهُۥ"
    },
    {
      "ayah_number": 56,
      "text": "وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىا وَأَهۡلُ ٱلۡمَغۡفِرَةِ"
    }
  ]
}
