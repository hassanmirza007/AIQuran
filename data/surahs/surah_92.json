{
  "surah": 92,
  "name": "Al-Layl",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَٱلَّيۡلِ إِذَا يَغۡشَىا"
    },
    {
      "ayah_number": 2,
      "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىا"
    },
    {
      "ayah_number": 3,
      "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىآ"
    },
    {
      "ayah_number": 4,
      "text": "إِنَّ سَعۡيَكُمۡ لَشَتَّىا"
    },
    {
      "ayah_number": 5,
      "text": "فَأَمَّا مَنۡ أَعۡطَىا وَٱتَّقَىا"
    },
    {
      "ayah_number": 6,
      "text": "وَصَدَّقَ بِٱلۡحُسۡنَىا"
    },
    {
      "ayah_number": 7,
      "text": "فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىا"
    },
    {
      "ayah_number": 8,
      "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىا"
    },
    {
      "ayah_number": 9,
      "text": "وَكَذَّبَ بِٱلۡحُسۡنَىا"
    },
    {
      "ayah_number": 10,
      "text": "فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىا"
    },
    {
      "ayah_number": 11,
      "text": "وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىآ"
    },
    {
      "ayah_number": 12,
      "text": "إِنَّ عَلَيۡنَا لَلۡهُدَىا"
    },
    {
      "ayah_number": 13,
      "text": "وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىا"
    },
    {
      "ayah_number": 14,
      "text": "فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىا"
    },
    {
      "ayah_number": 15,
      "text": "لَا يَصۡلَىاهَآ إِلَّا ٱلۡأَشۡقَى"
    },
    {
      "ayah_number": 16,
      "text": "ٱلَّذِي كَذَّبَ وَتَوَلَّىا"
    },
    {
      "ayah_number": 17,
      "text": "وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى"
    },
    {
      "ayah_number": 18,
      "text": "ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىا"
    },
    {
      "ayah_number": 19,
      "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىآ"
    },
    {
      "ayah_number": 20,
      "text": "إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىا"
    },
    {
      "ayah_number": 21,
      "text": "وَلَسَوۡفَ يَرۡضَىا"
    }
  ]
}
