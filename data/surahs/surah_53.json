{
  "surah": 53,
  "name": "An-Najm",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَٱلنَّجۡمِ إِذَا هَوَىا"
    },
    {
      "ayah_number": 2,
      "text": "مَا ضَلَّ صَاحِبُكُمۡ وَمَا غَوَىا"
    },
    {
      "ayah_number": 3,
      "text": "وَمَا يَنطِقُ عَنِ ٱلۡهَوَىآ"
    },
    {
      "ayah_number": 4,
      "text": "إِنۡ هُوَ إِلَّا وَحۡيٞ يُوحَىا"
    },
    {
      "ayah_number": 5,
      "text": "عَلَّمَهُۥ شَدِيدُ ٱلۡقُوَىا"
    },
    {
      "ayah_number": 6,
      "text": "ذُو مِرَّةٖ فَٱسۡتَوَىا"
    },
    {
      "ayah_number": 7,
      "text": "وَهُوَ بِٱلۡأُفُقِ ٱلۡأَعۡلَىا"
    },
    {
      "ayah_number": 8,
      "text": "ثُمَّ دَنَا فَتَدَلَّىا"
    },
    {
      "ayah_number": 9,
      "text": "فَكَانَ قَابَ قَوۡسَيۡنِ أَوۡ أَدۡنَىا"
    },
    {
      "ayah_number": 10,
      "text": "فَأَوۡحَىآ إِلَىا عَبۡدِهِۦ مَآ أَوۡحَىا"
    },
    {
      "ayah_number": 11,
      "text": "مَا كَذَبَ ٱلۡفُؤَادُ مَا رَأَىآ"
    },
    {
      "ayah_number": 12,
      "text": "أَفَتُمَارُونَهُۥ عَلَىا مَا يَرَىا"
    },
    {
      "ayah_number": 13,
      "text": "وَلَقَدۡ رَءَاهُ نَزۡلَةً أُخۡرَىا"
    },
    {
      "ayah_number": 14,
      "text": "عِندَ سِدۡرَةِ ٱلۡمُنتَهَىا"
    },
    {
      "ayah_number": 15,
      "text": "عِندَهَا جَنَّةُ ٱلۡمَأۡوَىآ"
    },
    {
      "ayah_number": 16,
      "text": "إِذۡ يَغۡشَى ٱلسِّدۡرَةَ مَا يَغۡشَىا"
    },
    {
      "ayah_number": 17,
      "text": "مَا زَاغَ ٱلۡبَصَرُ وَمَا طَغَىا"
    },
    {
      "ayah_number": 18,
      "text": "لَقَدۡ رَأَىا مِنۡ ءَايَاتِ رَبِّهِ ٱلۡكُبۡرَىآ"
    },
    {
      "ayah_number": 19,
      "text": "أَفَرَءَيۡتُمُ ٱللَّـاتَ وَٱلۡعُزَّىا"
    },
    {
      "ayah_number": 20,
      "text": "وَمَنَواةَ ٱلثَّالِثَةَ ٱلۡأُخۡرَىآ"
    },
    {
      "ayah_number": 21,
      "text": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلۡأُنثَىا"
    },
    {
      "ayah_number": 22,
      "text": "تِلۡكَ إِذٗا قِسۡمَةٞ ضِيزَىآ"
    },
    {
      "ayah_number": 23,
      "text": "إِنۡ هِيَ إِلَّآ أَسۡمَآءٞ سَمَّيۡتُمُوهَآ أَنتُمۡ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلۡطَانٍۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهۡوَى ٱلۡأَنفُسُۖ وَلَقَدۡ جَآءَهُم مِّن رَّبِّهِمُ ٱلۡهُدَىآ"
    },
    {
      "ayah_number": 24,
      "text": "أَمۡ لِلۡإِنسَانِ مَا تَمَنَّىا"
    },
    {
      "ayah_number": 25,
      "text": "فَلِلَّهِ ٱلۡأٓخِرَةُ وَٱلۡأُولَىا"
    },
    {
      "ayah_number": 26,
      "text": "۞وَكَم مِّن مَّلَكٖ فِي ٱلسَّمَاوَاتِ لَا تُغۡنِي شَفَاعَتُهُمۡ شَيۡـًٔا إِلَّا مِنۢ بَعۡدِ أَن يَأۡذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرۡضَىآ"
    },
    {
      "ayah_number": 27,
      "text": "إِنَّ ٱلَّذِينَ لَا يُؤۡمِنُونَ بِٱلۡأٓخِرَةِ لَيُسَمُّونَ ٱلۡمَلَـآئِكَةَ تَسۡمِيَةَ ٱلۡأُنثَىا"
    },
    {
      "ayah_number": 28,
      "text": "وَمَا لَهُم بِهِۦ مِنۡ عِلۡمٍۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّۖ وَإِنَّ ٱلظَّنَّ لَا يُغۡنِي مِنَ ٱلۡحَقِّ شَيۡـٔٗا"
    },
    {
      "ayah_number": 29,
      "text": "فَأَعۡرِضۡ عَن مَّن تَوَلَّىا عَن ذِكۡرِنَا وَلَمۡ يُرِدۡ إِلَّا ٱلۡحَيَواةَ ٱلدُّنۡيَا"
    },
    {
      "ayah_number": 30,
      "text": "ذَالِكَ مَبۡلَغُهُم مِّنَ ٱلۡعِلۡمِۚ إِنَّ رَبَّكَ هُوَ أَعۡلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعۡلَمُ بِمَنِ ٱهۡتَدَىا"
    },
    {
      "ayah_number": 31,
      "text": "وَلِلَّهِ مَا فِي ٱلسَّمَاوَاتِ وَمَا فِي ٱلۡأَرۡضِ لِيَجۡزِيَ ٱلَّذِينَ أَسَـآـُٔواْ بِمَا عَمِلُواْ وَيَجۡزِيَ ٱلَّذِينَ أَحۡسَنُواْ بِٱلۡحُسۡنَى"
    },
    {
      "ayah_number": 32,
      "text": "ٱلَّذِينَ يَجۡتَنِبُونَ كَبَـآئِرَ ٱلۡإِثۡمِ وَٱلۡفَوَاحِشَ إِلَّا ٱللَّمَمَۚ إِنَّ رَبَّكَ وَاسِعُ ٱلۡمَغۡفِرَةِۚ هُوَ أَعۡلَمُ بِكُمۡ إِذۡ أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ وَإِذۡ أَنتُمۡ أَجِنَّةٞ فِي بُطُونِ أُمَّهَاتِكُمۡۖ فَلَا تُزَكُّوٓاْ أَنفُسَكُمۡۖ هُوَ أَعۡلَمُ بِمَنِ ٱتَّقَىآ"
    },
    {
      "ayah_number": 33,
      "text": "أَفَرَءَيۡتَ ٱلَّذِي تَوَلَّىا"
    },
    {
      "ayah_number": 34,
      "text": "وَأَعۡطَىا قَلِيلٗا وَأَكۡدَىآ"
    },
    {
      "ayah_number": 35,
      "text": "أَعِندَهُۥ عِلۡمُ ٱلۡغَيۡبِ فَهُوَ يَرَىآ"
    },
    {
      "ayah_number": 36,
      "text": "أَمۡ لَمۡ يُنَبَّأۡ بِمَا فِي صُحُفِ مُوسَىا"
    },
    {
      "ayah_number": 37,
      "text": "وَإِبۡرَاهِيمَ ٱلَّذِي وَفَّىآ"
    },
    {
      "ayah_number": 38,
      "text": "أَلَّا تَزِرُ وَازِرَةٞ وِزۡرَ أُخۡرَىا"
    },
    {
      "ayah_number": 39,
      "text": "وَأَن لَّيۡسَ لِلۡإِنسَانِ إِلَّا مَا سَعَىا"
    },
    {
      "ayah_number": 40,
      "text": "وَأَنَّ سَعۡيَهُۥ سَوۡفَ يُرَىا"
    },
    {
      "ayah_number": 41,
      "text": "ثُمَّ يُجۡزَىاهُ ٱلۡجَزَآءَ ٱلۡأَوۡفَىا"
    },
    {
      "ayah_number": 42,
      "text": "وَأَنَّ إِلَىا رَبِّكَ ٱلۡمُنتَهَىا"
    },
    {
      "ayah_number": 43,
      "text": "وَأَنَّهُۥ هُوَ أَضۡحَكَ وَأَبۡكَىا"
    },
    {
      "ayah_number": 44,
      "text": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحۡيَا"
    },
    {
      "ayah_number": 45,
      "text": "وَأَنَّهُۥ خَلَقَ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىا"
    },
    {
      "ayah_number": 46,
      "text": "مِن نُّطۡفَةٍ إِذَا تُمۡنَىا"
    },
    {
      "ayah_number": 47,
      "text": "وَأَنَّ عَلَيۡهِ ٱلنَّشۡأَةَ ٱلۡأُخۡرَىا"
    },
    {
      "ayah_number": 48,
      "text": "وَأَنَّهُۥ هُوَ أَغۡنَىا وَأَقۡنَىا"
    },
    {
      "ayah_number": 49,
      "text": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعۡرَىا"
    },
    {
      "ayah_number": 50,
      "text": "وَأَنَّهُۥٓ أَهۡلَكَ عَادًا ٱلۡأُولَىا"
    },
    {
      "ayah_number": 51,
      "text": "وَثَمُودَاْ فَمَآ أَبۡقَىا"
    },
    {
      "ayah_number": 52,
      "text": "وَقَوۡمَ نُوحٖ مِّن قَبۡلُۖ إِنَّهُمۡ كَانُواْ هُمۡ أَظۡلَمَ وَأَطۡغَىا"
    },
    {
      "ayah_number": 53,
      "text": "وَٱلۡمُؤۡتَفِكَةَ أَهۡوَىا"
    },
    {
      "ayah_number": 54,
      "text": "فَغَشَّىاهَا مَا غَشَّىا"
    },
    {
      "ayah_number": 55,
      "text": "فَبِأَيِّ ءَالَآءِ رَبِّكَ تَتَمَارَىا"
    },
    {
      "ayah_number": 56,
      "text": "هَاذَا نَذِيرٞ مِّنَ ٱلنُّذُرِ ٱلۡأُولَىآ"
    },
    {
      "ayah_number": 57,
      "text": "أَزِفَتِ ٱلۡأٓزِفَةُ"
    },
    {
      "ayah_number": 58,
      "text": "لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ"
    },
    {
      "ayah_number": 59,
      "text": "أَفَمِنۡ هَاذَا ٱلۡحَدِيثِ تَعۡجَبُونَ"
    },
    {
      "ayah_number": 60,
      "text": "وَتَضۡحَكُونَ وَلَا تَبۡكُونَ"
    },
    {
      "ayah_number": 61,
      "text": "وَأَنتُمۡ سَامِدُونَ"
    },
    {
      "ayah_number": 62,
      "text": "فَٱسۡجُدُواْۤ لِلَّهِۤ وَٱعۡبُدُواْ۩"
    }
  ]
}
