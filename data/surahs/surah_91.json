{
  "surah": 91,
  "name": "Ash-Shams",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَٱلشَّمۡسِ وَضُحَىاهَا"
    },
    {
      "ayah_number": 2,
      "text": "وَٱلۡقَمَرِ إِذَا تَلَىاهَا"
    },
    {
      "ayah_number": 3,
      "text": "وَٱلنَّهَارِ إِذَا جَلَّىاهَا"
    },
    {
      "ayah_number": 4,
      "text": "وَٱلَّيۡلِ إِذَا يَغۡشَىاهَا"
    },
    {
      "ayah_number": 5,
      "text": "وَٱلسَّمَآءِ وَمَا بَنَىاهَا"
    },
    {
      "ayah_number": 6,
      "text": "وَٱلۡأَرۡضِ وَمَا طَحَىاهَا"
    },
    {
      "ayah_number": 7,
      "text": "وَنَفۡسٖ وَمَا سَوَّىاهَا"
    },
    {
      "ayah_number": 8,
      "text": "فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىاهَا"
    },
    {
      "ayah_number": 9,
      "text": "قَدۡ أَفۡلَحَ مَن زَكَّىاهَا"
    },
    {
      "ayah_number": 10,
      "text": "وَقَدۡ خَابَ مَن دَسَّىاهَا"
    },
    {
      "ayah_number": 11,
      "text": "كَذَّبَتۡ ثَمُودُ بِطَغۡوَىاهَآ"
    },
    {
      "ayah_number": 12,
      "text": "إِذِ ٱنۢبَعَثَ أَشۡقَىاهَا"
    },
    {
      "ayah_number": 13,
      "text": "فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَاهَا"
    },
    {
      "ayah_number": 14,
      "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىاهَا"
    },
    {
      "ayah_number": 15,
      "text": "وَلَا يَخَافُ عُقۡبَاهَا"
    }
  ]
}
