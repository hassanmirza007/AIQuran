{
  "surah": 80,
  "name": "'Abasa",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "عَبَسَ وَتَوَلَّىآ"
    },
    {
      "ayah_number": 2,
      "text": "أَن جَآءَهُ ٱلۡأَعۡمَىا"
    },
    {
      "ayah_number": 3,
      "text": "وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىآ"
    },
    {
      "ayah_number": 4,
      "text": "أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىآ"
    },
    {
      "ayah_number": 5,
      "text": "أَمَّا مَنِ ٱسۡتَغۡنَىا"
    },
    {
      "ayah_number": 6,
      "text": "فَأَنتَ لَهُۥ تَصَدَّىا"
    },
    {
      "ayah_number": 7,
      "text": "وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىا"
    },
    {
      "ayah_number": 8,
      "text": "وَأَمَّا مَن جَآءَكَ يَسۡعَىا"
    },
    {
      "ayah_number": 9,
      "text": "وَهُوَ يَخۡشَىا"
    },
    {
      "ayah_number": 10,
      "text": "فَأَنتَ عَنۡهُ تَلَهَّىا"
    },
    {
      "ayah_number": 11,
      "text": "كَلَّآ إِنَّهَا تَذۡكِرَةٞ"
    },
    {
      "ayah_number": 12,
      "text": "فَمَن شَآءَ ذَكَرَهُۥ"
    },
    {
      "ayah_number": 13,
      "text": "فِي صُحُفٖ مُّكَرَّمَةٖ"
    },
    {
      "ayah_number": 14,
      "text": "مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ"
    },
    {
      "ayah_number": 15,
      "text": "بِأَيۡدِي سَفَرَةٖ"
    },
    {
      "ayah_number": 16,
      "text": "كِرَامِۭ بَرَرَةٖ"
    },
    {
      "ayah_number": 17,
      "text": "قُتِلَ ٱلۡإِنسَانُ مَآ أَكۡفَرَهُۥ"
    },
    {
      "ayah_number": 18,
      "text": "مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ"
    },
    {
      "ayah_number": 19,
      "text": "مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ"
    },
    {
      "ayah_number": 20,
      "text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ"
    },
    {
      "ayah_number": 21,
      "text": "ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ"
    },
    {
      "ayah_number": 22,
      "text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ"
    },
    {
      "ayah_number": 23,
      "text": "كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ"
    },
    {
      "ayah_number": 24,
      "text": "فَلۡيَنظُرِ ٱلۡإِنسَانُ إِلَىا طَعَامِهِۦٓ"
    },
    {
      "ayah_number": 25,
      "text": "أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا"
    },
    {
      "ayah_number": 26,
      "text": "ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا"
    },
    {
      "ayah_number": 27,
      "text": "فَأَنۢبَتۡنَا فِيهَا حَبّٗا"
    },
    {
      "ayah_number": 28,
      "text": "وَعِنَبٗا وَقَضۡبٗا"
    },
    {
      "ayah_number": 29,
      "text": "وَزَيۡتُونٗا وَنَخۡلٗا"
    },
    {
      "ayah_number": 30,
      "text": "وَحَدَآئِقَ غُلۡبٗا"
    },
    {
      "ayah_number": 31,
      "text": "وَفَاكِهَةٗ وَأَبّٗا"
    },
    {
      "ayah_number": 32,
      "text": "مَّتَاعٗا لَّكُمۡ وَلِأَنۡعَامِكُمۡ"
    },
    {
      "ayah_number": 33,
      "text": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ"
    },
    {
      "ayah_number": 34,
      "text": "يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ"
    },
    {
      "ayah_number": 35,
      "text": "وَأُمِّهِۦ وَأَبِيهِ"
    },
    {
      "ayah_number": 36,
      "text": "وَصَاحِبَتِهِۦ وَبَنِيهِ"
    },
    {
      "ayah_number": 37,
      "text": "لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ"
    },
    {
      "ayah_number": 38,
      "text": "وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ"
    },
    {
      "ayah_number": 39,
      "text": "ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ"
    },
    {
      "ayah_number": 40,
      "text": "وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ"
    },
    {
      "ayah_number": 41,
      "text": "تَرۡهَقُهَا قَتَرَةٌ"
    },
    {
      "ayah_number": 42,
      "text": "أُوْلَـآئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ"
    }
  ]
}
