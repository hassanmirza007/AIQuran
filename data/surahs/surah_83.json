{
  "surah": 83,
  "name": "Al-Mutaffifin",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَيۡلٞ لِّلۡمُطَفِّفِينَ"
    },
    {
      "ayah_number": 2,
      "text": "ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ يَسۡتَوۡفُونَ"
    },
    {
      "ayah_number": 3,
      "text": "وَإِذَا كَالُوهُمۡ أَو وَّزَنُوهُمۡ يُخۡسِرُونَ"
    },
    {
      "ayah_number": 4,
      "text": "أَلَا يَظُنُّ أُوْلَـآئِكَ أَنَّهُم مَّبۡعُوثُونَ"
    },
    {
      "ayah_number": 5,
      "text": "لِيَوۡمٍ عَظِيمٖ"
    },
    {
      "ayah_number": 6,
      "text": "يَوۡمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلۡعَالَمِينَ"
    },
    {
      "ayah_number": 7,
      "text": "كَلَّآ إِنَّ كِتَابَ ٱلۡفُجَّارِ لَفِي سِجِّينٖ"
    },
    {
      "ayah_number": 8,
      "text": "وَمَآ أَدۡرَىاكَ مَا سِجِّينٞ"
    },
    {
      "ayah_number": 9,
      "text": "كِتَابٞ مَّرۡقُومٞ"
    },
    {
      "ayah_number": 10,
      "text": "وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ"
    },
    {
      "ayah_number": 11,
      "text": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوۡمِ ٱلدِّينِ"
    },
    {
      "ayah_number": 12,
      "text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعۡتَدٍ أَثِيمٍ"
    },
    {
      "ayah_number": 13,
      "text": "إِذَا تُتۡلَىا عَلَيۡهِ ءَايَاتُنَا قَالَ أَسَاطِيرُ ٱلۡأَوَّلِينَ"
    },
    {
      "ayah_number": 14,
      "text": "كَلَّاۖ بَلۡۜ رَانَ عَلَىا قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ"
    },
    {
      "ayah_number": 15,
      "text": "كَلَّآ إِنَّهُمۡ عَن رَّبِّهِمۡ يَوۡمَئِذٖ لَّمَحۡجُوبُونَ"
    },
    {
      "ayah_number": 16,
      "text": "ثُمَّ إِنَّهُمۡ لَصَالُواْ ٱلۡجَحِيمِ"
    },
    {
      "ayah_number": 17,
      "text": "ثُمَّ يُقَالُ هَاذَا ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ"
    },
    {
      "ayah_number": 18,
      "text": "كَلَّآ إِنَّ كِتَابَ ٱلۡأَبۡرَارِ لَفِي عِلِّيِّينَ"
    },
    {
      "ayah_number": 19,
      "text": "وَمَآ أَدۡرَىاكَ مَا عِلِّيُّونَ"
    },
    {
      "ayah_number": 20,
      "text": "كِتَابٞ مَّرۡقُومٞ"
    },
    {
      "ayah_number": 21,
      "text": "يَشۡهَدُهُ ٱلۡمُقَرَّبُونَ"
    },
    {
      "ayah_number": 22,
      "text": "إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٍ"
    },
    {
      "ayah_number": 23,
      "text": "عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ"
    },
    {
      "ayah_number": 24,
      "text": "تَعۡرِفُ فِي وُجُوهِهِمۡ نَضۡرَةَ ٱلنَّعِيمِ"
    },
    {
      "ayah_number": 25,
      "text": "يُسۡقَوۡنَ مِن رَّحِيقٖ مَّخۡتُومٍ"
    },
    {
      "ayah_number": 26,
      "text": "خِتَامُهُۥ مِسۡكٞۚ وَفِي ذَالِكَ فَلۡيَتَنَافَسِ ٱلۡمُتَنَافِسُونَ"
    },
    {
      "ayah_number": 27,
      "text": "وَمِزَاجُهُۥ مِن تَسۡنِيمٍ"
    },
    {
      "ayah_number": 28,
      "text": "عَيۡنٗا يَشۡرَبُ بِهَا ٱلۡمُقَرَّبُونَ"
    },
    {
      "ayah_number": 29,
      "text": "إِنَّ ٱلَّذِينَ أَجۡرَمُواْ كَانُواْ مِنَ ٱلَّذِينَ ءَامَنُواْ يَضۡحَكُونَ"
    },
    {
      "ayah_number": 30,
      "text": "وَإِذَا مَرُّواْ بِهِمۡ يَتَغَامَزُونَ"
    },
    {
      "ayah_number": 31,
      "text": "وَإِذَا ٱنقَلَبُوٓاْ إِلَىآ أَهۡلِهِمُ ٱنقَلَبُواْ فَكِهِينَ"
    },
    {
      "ayah_number": 32,
      "text": "وَإِذَا رَأَوۡهُمۡ قَالُوٓاْ إِنَّ هَـآؤُلَآءِ لَضَآلُّونَ"
    },
    {
      "ayah_number": 33,
      "text": "وَمَآ أُرۡسِلُواْ عَلَيۡهِمۡ حَافِظِينَ"
    },
    {
      "ayah_number": 34,
      "text": "فَٱلۡيَوۡمَ ٱلَّذِينَ ءَامَنُواْ مِنَ ٱلۡكُفَّارِ يَضۡحَكُونَ"
    },
    {
      "ayah_number": 35,
      "text": "عَلَى ٱلۡأَرَآئِكِ يَنظُرُونَ"
    },
    {
      "ayah_number": 36,
      "text": "هَلۡ ثُوِّبَ ٱلۡكُفَّارُ مَا كَانُواْ يَفۡعَلُونَ"
    }
  ]
}
