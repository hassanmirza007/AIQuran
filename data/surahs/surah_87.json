{
  "surah": 87,
  "name": "Al-A'la",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى"
    },
    {
      "ayah_number": 2,
      "text": "ٱلَّذِي خَلَقَ فَسَوَّىا"
    },
    {
      "ayah_number": 3,
      "text": "وَٱلَّذِي قَدَّرَ فَهَدَىا"
    },
    {
      "ayah_number": 4,
      "text": "وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىا"
    },
    {
      "ayah_number": 5,
      "text": "فَجَعَلَهُۥ غُثَآءً أَحۡوَىا"
    },
    {
      "ayah_number": 6,
      "text": "سَنُقۡرِئُكَ فَلَا تَنسَىآ"
    },
    {
      "ayah_number": 7,
      "text": "إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىا"
    },
    {
      "ayah_number": 8,
      "text": "وَنُيَسِّرُكَ لِلۡيُسۡرَىا"
    },
    {
      "ayah_number": 9,
      "text": "فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىا"
    },
    {
      "ayah_number": 10,
      "text": "سَيَذَّكَّرُ مَن يَخۡشَىا"
    },
    {
      "ayah_number": 11,
      "text": "وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى"
    },
    {
      "ayah_number": 12,
      "text": "ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىا"
    },
    {
      "ayah_number": 13,
      "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىا"
    },
    {
      "ayah_number": 14,
      "text": "قَدۡ أَفۡلَحَ مَن تَزَكَّىا"
    },
    {
      "ayah_number": 15,
      "text": "وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىا"
    },
    {
      "ayah_number": 16,
      "text": "بَلۡ تُؤۡثِرُونَ ٱلۡحَيَواةَ ٱلدُّنۡيَا"
    },
    {
      "ayah_number": 17,
      "text": "وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىآ"
    },
    {
      "ayah_number": 18,
      "text": "إِنَّ هَاذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىا"
    },
    {
      "ayah_number": 19,
      "text": "صُحُفِ إِبۡرَاهِيمَ وَمُوسَىا"
    }
  ]
}
