{
  "surah": 79,
  "name": "An-Nazi'at",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَٱلنَّـازِعَاتِ غَرۡقٗا"
    },
    {
      "ayah_number": 2,
      "text": "وَٱلنَّـاشِطَاتِ نَشۡطٗا"
    },
    {
      "ayah_number": 3,
      "text": "وَٱلسَّـابِحَاتِ سَبۡحٗا"
    },
    {
      "ayah_number": 4,
      "text": "فَٱلسَّـابِقَاتِ سَبۡقٗا"
    },
    {
      "ayah_number": 5,
      "text": "فَٱلۡمُدَبِّرَاتِ أَمۡرٗا"
    },
    {
      "ayah_number": 6,
      "text": "يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ"
    },
    {
      "ayah_number": 7,
      "text": "تَتۡبَعُهَا ٱلرَّادِفَةُ"
    },
    {
      "ayah_number": 8,
      "text": "قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ"
    },
    {
      "ayah_number": 9,
      "text": "أَبۡصَارُهَا خَاشِعَةٞ"
    },
    {
      "ayah_number": 10,
      "text": "يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ"
    },
    {
      "ayah_number": 11,
      "text": "أَءِذَا كُنَّا عِظَامٗا نَّخِرَةٗ"
    },
    {
      "ayah_number": 12,
      "text": "قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ"
    },
    {
      "ayah_number": 13,
      "text": "فَإِنَّمَا هِيَ زَجۡرَةٞ وَاحِدَةٞ"
    },
    {
      "ayah_number": 14,
      "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ"
    },
    {
      "ayah_number": 15,
      "text": "هَلۡ أَتَىاكَ حَدِيثُ مُوسَىآ"
    },
    {
      "ayah_number": 16,
      "text": "إِذۡ نَادَىاهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى"
    },
    {
      "ayah_number": 17,
      "text": "ٱذۡهَبۡ إِلَىا فِرۡعَوۡنَ إِنَّهُۥ طَغَىا"
    },
    {
      "ayah_number": 18,
      "text": "فَقُلۡ هَل لَّكَ إِلَىآ أَن تَزَكَّىا"
    },
    {
      "ayah_number": 19,
      "text": "وَأَهۡدِيَكَ إِلَىا رَبِّكَ فَتَخۡشَىا"
    },
    {
      "ayah_number": 20,
      "text": "فَأَرَىاهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىا"
    },
    {
      "ayah_number": 21,
      "text": "فَكَذَّبَ وَعَصَىا"
    },
    {
      "ayah_number": 22,
      "text": "ثُمَّ أَدۡبَرَ يَسۡعَىا"
    },
    {
      "ayah_number": 23,
      "text": "فَحَشَرَ فَنَادَىا"
    },
    {
      "ayah_number": 24,
      "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىا"
    },
    {
      "ayah_number": 25,
      "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىآ"
    },
    {
      "ayah_number": 26,
      "text": "إِنَّ فِي ذَالِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىآ"
    },
    {
      "ayah_number": 27,
      "text": "ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىاهَا"
    },
    {
      "ayah_number": 28,
      "text": "رَفَعَ سَمۡكَهَا فَسَوَّىاهَا"
    },
    {
      "ayah_number": 29,
      "text": "وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىاهَا"
    },
    {
      "ayah_number": 30,
      "text": "وَٱلۡأَرۡضَ بَعۡدَ ذَالِكَ دَحَىاهَآ"
    },
    {
      "ayah_number": 31,
      "text": "أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىاهَا"
    },
    {
      "ayah_number": 32,
      "text": "وَٱلۡجِبَالَ أَرۡسَىاهَا"
    },
    {
      "ayah_number": 33,
      "text": "مَتَاعٗا لَّكُمۡ وَلِأَنۡعَامِكُمۡ"
    },
    {
      "ayah_number": 34,
      "text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىا"
    },
    {
      "ayah_number": 35,
      "text": "يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَانُ مَا سَعَىا"
    },
    {
      "ayah_number": 36,
      "text": "وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىا"
    },
    {
      "ayah_number": 37,
      "text": "فَأَمَّا مَن طَغَىا"
    },
    {
      "ayah_number": 38,
      "text": "وَءَاثَرَ ٱلۡحَيَواةَ ٱلدُّنۡيَا"
    },
    {
      "ayah_number": 39,
      "text": "فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىا"
    },
    {
      "ayah_number": 40,
      "text": "وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىا"
    },
    {
      "ayah_number": 41,
      "text": "فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىا"
    },
    {
      "ayah_number": 42,
      "text": "يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىاهَا"
    },
    {
      "ayah_number": 43,
      "text": "فِيمَ أَنتَ مِن ذِكۡرَىاهَآ"
    },
    {
      "ayah_number": 44,
      "text": "إِلَىا رَبِّكَ مُنتَهَىاهَآ"
    },
    {
      "ayah_number": 45,
      "text": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىاهَا"
    },
    {
      "ayah_number": 46,
      "text": "كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىاهَا"
    }
  ]
}
