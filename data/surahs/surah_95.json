{
  "surah": 95,
  "name": "At-Tin",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَٱلتِّينِ وَٱلزَّيۡتُونِ"
    },
    {
      "ayah_number": 2,
      "text": "وَطُورِ سِينِينَ"
    },
    {
      "ayah_number": 3,
      "text": "وَهَاذَا ٱلۡبَلَدِ ٱلۡأَمِينِ"
    },
    {
      "ayah_number": 4,
      "text": "لَقَدۡ خَلَقۡنَا ٱلۡإِنسَانَ فِيٓ أَحۡسَنِ تَقۡوِيمٖ"
    },
    {
      "ayah_number": 5,
      "text": "ثُمَّ رَدَدۡنَاهُ أَسۡفَلَ سَافِلِينَ"
    },
    {
      "ayah_number": 6,
      "text": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـالِحَاتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونٖ"
    },
    {
      "ayah_number": 7,
      "text": "فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ"
    },
    {
      "ayah_number": 8,
      "text": "أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَاكِمِينَ"
    }
  ]
}
