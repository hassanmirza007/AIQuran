{
  "surah": 89,
  "name": "Al-Fajr",
  "ayahs": [
    {
      "ayah_number": 1,
      "text": "وَٱلۡفَجۡرِ"
    },
    {
      "ayah_number": 2,
      "text": "وَلَيَالٍ عَشۡرٖ"
    },
    {
      "ayah_number": 3,
      "text": "وَٱلشَّفۡعِ وَٱلۡوَتۡرِ"
    },
    {
      "ayah_number": 4,
      "text": "وَٱلَّيۡلِ إِذَا يَسۡرِ"
    },
    {
      "ayah_number": 5,
      "text": "هَلۡ فِي ذَالِكَ قَسَمٞ لِّذِي حِجۡرٍ"
    },
    {
      "ayah_number": 6,
      "text": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ"
    },
    {
      "ayah_number": 7,
      "text": "إِرَمَ ذَاتِ ٱلۡعِمَادِ"
    },
    {
      "ayah_number": 8,
      "text": "ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَادِ"
    },
    {
      "ayah_number": 9,
      "text": "وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ"
    },
    {
      "ayah_number": 10,
      "text": "وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ"
    },
    {
      "ayah_number": 11,
      "text": "ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَادِ"
    },
    {
      "ayah_number": 12,
      "text": "فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ"
    },
    {
      "ayah_number": 13,
      "text": "فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ"
    },
    {
      "ayah_number": 14,
      "text": "إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ"
    },
    {
      "ayah_number": 15,
      "text": "فَأَمَّا ٱلۡإِنسَانُ إِذَا مَا ٱبۡتَلَىاهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ"
    },
    {
      "ayah_number": 16,
      "text": "وَأَمَّآ إِذَا مَا ٱبۡتَلَىاهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَانَنِ"
    },
    {
      "ayah_number": 17,
      "text": "كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ"
    },
    {
      "ayah_number": 18,
      "text": "وَلَا تَحَـآضُّونَ عَلَىا طَعَامِ ٱلۡمِسۡكِينِ"
    },
    {
      "ayah_number": 19,
      "text": "وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا"
    },
    {
      "ayah_number": 20,
      "text": "وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا"
    },
    {
      "ayah_number": 21,
      "text": "كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا"
    },
    {
      "ayah_number": 22,
      "text": "وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا"
    },
    {
      "ayah_number": 23,
      "text": "وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَانُ وَأَنَّىا لَهُ ٱلذِّكۡرَىا"
    },
    {
      "ayah_number": 24,
      "text": "يَقُولُ يَالَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي"
    },
    {
      "ayah_number": 25,
      "text": "فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ"
    },
    {
      "ayah_number": 26,
      "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ"
    },
    {
      "ayah_number": 27,
      "text": "يَـآأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ"
    },
    {
      "ayah_number": 28,
      "text": "ٱرۡجِعِيٓ إِلَىا رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ"
    },
    {
      "ayah_number": 29,
      "text": "فَٱدۡخُلِي فِي عِبَادِي"
    },
    {
      "ayah_number": 30,
      "text": "وَٱدۡخُلِي جَنَّتِي"
    }
  ]
}
